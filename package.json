{
  "name": "datetick",
  "version": "1.2.0",
  "description": "DateTick — a tiny, immutable, fully timezone-aware date toolkit: formatting, parsing, durations and live relative-time, for any framework.",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "browser": "dist/index.umd.min.js",
  "private": false,
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "browser": "./dist/index.umd.min.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix",
    "test": "cross-env TZ=UTC jest",
    "test:ci": "cross-env TZ=UTC JEST_JUNIT_CLASSNAME=\"{filepath}\" jest --reporters=default --reporters=jest-junit",
    "test:watch": "cross-env TZ=UTC jest --watch",
    "test:coverage": "cross-env TZ=UTC jest --coverage",
    "test:bundle": "npx bundlewatch",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andreasnicolaou/datetick.git"
  },
  "bugs": {
    "url": "https://github.com/andreasnicolaou/datetick/issues"
  },
  "homepage": "https://andreasnicolaou.github.io/datetick/",
  "author": {
    "name": "Andreas Nicolaou",
    "email": "anicolaou66@gmail.com"
  },
  "license": "MIT",
  "jest": {
    "transform": {
      "^.+\\.(ts)$": [
        "ts-jest"
      ]
    },
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "bundlewatch": {
    "files": [
      {
        "path": "dist/index.js",
        "maxSize": "25kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.umd.js",
        "maxSize": "25kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.umd.min.js",
        "maxSize": "10kB",
        "compression": "gzip"
      }
    ]
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "bundlewatch": "^0.4.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.4.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "axios": "^1.18.1",
    "brace-expansion": "^5.0.8",
    "js-yaml": "^4.2.0",
    "serialize-javascript": "^7.0.6"
  },
  "keywords": [
    "datetick",
    "date",
    "datetime",
    "time",
    "timezone",
    "format",
    "parse",
    "duration",
    "timeago",
    "relative-time",
    "immutable",
    "reactive",
    "framework-agnostic",
    "angular",
    "react",
    "vue",
    "typescript",
    "andreasnicolaou"
  ]
}
